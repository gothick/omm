includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    phpVersion: 80300
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    bootstrapFiles:
        # If this doesn't work, try maybe vendor/bin/.phpunit/phpunit/vendor/autoload.php
        - vendor/autoload.php
